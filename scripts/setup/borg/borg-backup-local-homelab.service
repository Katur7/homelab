# borg-backup-local-homelab.service — Local Borg backup for homelab config and state
[Unit]
Description=Local BorgBackup for Homelab
Documentation=https://borgbackup.readthedocs.io/
After=local-fs.target
ConditionPathExists=/root/.borg-passphrase

[Service]
Type=oneshot
ExecStart=/home/grimur/homelab/infrastructure/backup/backup-local.sh homelab
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
