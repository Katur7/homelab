# Non-sensitive configuration for Hermes Workspace
HERMES_AGENT_URL=http://host.docker.internal:8642
HERMES_API_URL=http://host.docker.internal:8642
HERMES_DASHBOARD_URL=http://host.docker.internal:9119

# Reverse-proxy session cookie compatibility
COOKIE_SECURE=0

# Ingress authentication is handled by Traefik + Authelia (authelia-auth@file)
# on the isolated traefik_internal network.
HERMES_ALLOW_INSECURE_REMOTE=1
