# Journiv — non-secret configuration (tracked in Git)

DOMAIN_NAME=dagbok.pippinn.me
DOMAIN_SCHEME=https
ENVIRONMENT=production
DISABLE_SIGNUP=true

# Immich integration
IMMICH_BASE_URL=https://photos.pippinn.me

# Celery worker tuning (low-resource NAS)
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=300000
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
