# MongoDB Initialization & Core Database User
MONGO_INITDB_ROOT_USERNAME=komodo
KOMODO_DATABASE_USERNAME=komodo

# Komodo Host & Server Naming
KOMODO_HOST=https://komodo.internal.pippinn.me
KOMODO_TITLE=Komodo
KOMODO_FIRST_SERVER_NAME=NAS

# Mutual Authentication Keys between Core and Periphery
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=NAS
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

# Periphery Settings
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
